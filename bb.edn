{:paths
 ["src" "." "bb"]

 ;; this makes sure the test runner is available if you jack-in with Babashka
 ;; so you can eval code in the test namespaces:
 :deps
 {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}
  io.github.babashka/deps-deploy       {:mvn/version "0.0.1"}
  io.github.paintparty/sugar           {:mvn/version "0.1.0"}}

 :min-bb-version
 "1.13.222"

 :tasks
 {:requires
  [build
   [tasks.clojars :as clojars]
   [tasks.docs :as docs]]

  test
  {:doc  "Run the test suite."
   :task (clojure "-M:test" "-m" "cognitect.test-runner")}

  test:bb
  {:doc         "Run the test suite using Babashka to check compatibility."
   :extra-paths ["test"]
   :task        (exec 'cognitect.test-runner.api/test)}

  test:visual
  {:doc         "Print the example CSS in each preset theme, and in monokai-universal with each color variant."
   :extra-paths ["test"]
   :requires    ([cssyes.visual :as visual])
   :task        (visual/-main)}

  test:jolt
  {:doc  "Run the test suite using Jolt."
   :task (shell "jolt" "-M:jolt-test")}

  test:cljs
  {:doc  "Run the test suite in ClojureScript on Node, with shadow-cljs."
   :task (shell "npm" "test")}

  test:all
  {:doc     "Run the test suite for all target platforms."
   :depends [test test:bb test:jolt test:cljs]}

  ci
  {:doc     "Run the CI pipeline of tests and build the JAR."
   :depends [test:all] ; or just test
   :exec-fn build/jar}

  ci:deploy
  {:doc     "Run the tests, then build and deploy the JAR to Clojars."
   :depends [test:all]
   :task    (run 'deploy)}

  deploy
  {:doc      "Build the JAR and deploy it to Clojars. Requires CLOJARS_USERNAME and CLOJARS_PASSWORD (a deploy token) in the environment, or a with-clojars-creds command on your PATH that supplies them."
   :requires ([babashka.fs :as fs])
   :task     (do (exec 'build/jar)
                 (if (fs/which "with-clojars-creds")
                   (shell "with-clojars-creds" "bb" "-x" "build/deploy")
                   (exec 'build/deploy)))}

  clojars-info
  {:doc  "Print the latest release and the Clojars record for the lib in build.clj."
   :task (clojars/info)}

  install
  {:doc     "Install the JAR locally (build via ci)."
   :depends [ci]
   :task    (exec 'build/install)}

  ;; Docs
  ;; ---------------------------------------------------------------------------
  docs:readme
  {:doc  "Update the version numbers in README.md to match the latest tag (v0.2.0 -> 0.2.0). Leaves README.md alone if there are no tags yet."
   :task (docs/update-readme)}

  docs:git-deps
  {:doc  "Regenerate doc/git-deps.md from the latest tag.
          Uses HEAD if there are no tags yet."
   :task (docs/write-git-deps "doc/git-deps.md")}}}
