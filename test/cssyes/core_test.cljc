(ns cssyes.core-test
  (:require [clojure.test :refer [deftest is testing]]
            [cssyes.core :as sut])) ; system under test

(def example-1-input
".foo {
  &:link {
    color: silver;
  }
  &:visited {
    color: silver;
  }
  &:focus {
    color: silver;
  }
  &:hover {
    color: gold;
  }
  &:active {
    color: maroon;
  }
  &::before {
    content: \"cssyes\";
  }
  @media(min-width: 640px) {
    color: blue;
  }
  @media(min-width: 1280px) {
    color: orange;
  }
  @supports(color: color-mix(in oklch, red, red)) {
    color: blue;
  }
}")

